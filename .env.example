# Copy to .env for local Docker Compose. Change all passwords.
MYSQL_DATABASE=loanwise
MYSQL_USER=loanuser
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password

# For AWS, set DATABASE_URL in the backend container using a secret:
# mysql+pymysql://USER:PASSWORD@RDS_ENDPOINT:3306/loanwise